# OCI image for the Rommé signaling server (no npm dependencies).
# It also serves the game itself (public/) unless SERVE_GAME=false.
# Build from the repository root:
#   podman build -t romme-signaling -f server/Containerfile .
#   docker build -t romme-signaling -f server/Containerfile .
FROM docker.io/library/node:22-alpine

LABEL org.opencontainers.image.title="romme-signaling" \
      org.opencontainers.image.description="Rommé card game: WebRTC signaling relay and the game's web page" \
      org.opencontainers.image.licenses="MIT"

ENV NODE_ENV=production \
    PORT=8080 \
    HOST=0.0.0.0 \
    ALLOWED_ORIGINS=* \
    ROOM_IDLE_MINUTES=120 \
    SERVE_GAME=true

WORKDIR /app
COPY server/package.json server/server.js ./
COPY public ./public

USER node
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD wget -qO- "http://127.0.0.1:${PORT}/healthz" > /dev/null || exit 1

CMD ["node", "server.js"]
