# OCI image for the Games with Friends signaling server (no npm dependencies).
# It also serves the game itself (public/) unless SERVE_GAME=false.
# Build from the repository root:
#   podman build -t games-with-friends -f server/Containerfile .
#   docker build -t games-with-friends -f server/Containerfile .
FROM docker.io/library/node:22-alpine

LABEL org.opencontainers.image.title="games-with-friends" \
      org.opencontainers.image.description="Games with Friends (Rommé, UNO, Monopoly Deal): WebRTC signaling relay and the game page" \
      org.opencontainers.image.source="https://github.com/5V715/games-with-friends" \
      org.opencontainers.image.licenses="MIT"

ENV NODE_ENV=production \
    PORT=8080 \
    HOST=0.0.0.0 \
    ALLOWED_ORIGINS=* \
    ROOM_IDLE_MINUTES=120 \
    SERVE_GAME=true

WORKDIR /app
COPY server/package.json server/server.js ./
COPY public ./public

USER node
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD wget -qO- "http://127.0.0.1:${PORT}/healthz" > /dev/null || exit 1

CMD ["node", "server.js"]
